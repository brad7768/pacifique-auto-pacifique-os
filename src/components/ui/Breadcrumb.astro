---
import Link from './Link.astro';

export type Crumb = { label: string; href?: string };

interface Props {
  items: Crumb[];
  inverse?: boolean;
  class?: string;
}
const { items, inverse = false, class: className = '' } = Astro.props;
---

<nav class:list={['pa-breadcrumb', inverse && 'pa-breadcrumb--inverse', className]} aria-label="Fil d'Ariane">
  <ol class="pa-breadcrumb__list" role="list">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="pa-breadcrumb__item">
          {item.href && !isLast ? (
            <Link href={item.href} muted>{item.label}</Link>
          ) : (
            <span aria-current={isLast ? 'page' : undefined}>{item.label}</span>
          )}
          {!isLast && <span class="pa-breadcrumb__sep" aria-hidden="true">/</span>}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .pa-breadcrumb {
    font-size: var(--pa-text-caption);
  }

  .pa-breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pa-space-2);
    align-items: center;
  }

  .pa-breadcrumb__item {
    display: inline-flex;
    align-items: center;
    gap: var(--pa-space-2);
    color: var(--pa-color-text-muted);
  }

  .pa-breadcrumb__sep {
    color: var(--pa-color-border);
  }

  [aria-current='page'] {
    color: var(--pa-color-text);
    font-weight: var(--pa-weight-medium);
  }

  .pa-breadcrumb--inverse,
  .pa-breadcrumb--inverse :global(.pa-link--muted) {
    color: var(--pa-color-text-on-dark-muted);
  }

  .pa-breadcrumb--inverse [aria-current='page'] {
    color: var(--pa-color-text-inverse);
  }

  .pa-breadcrumb--inverse :global(.pa-link--muted:hover) {
    color: var(--pa-color-text-inverse);
  }
</style>

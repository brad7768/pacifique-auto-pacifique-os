---
import Card from './Card.astro';

interface Props {
  title: string;
  description?: string;
  href?: string;
  imageSrc?: string;
  imageAlt?: string;
  pattern?: 'btp' | 'mines' | 'transport' | 'agriculture' | 'energie';
  index?: string;
  class?: string;
}
const {
  title,
  description,
  href,
  imageSrc,
  imageAlt = '',
  pattern,
  index,
  class: className = '',
} = Astro.props;
---

<Card href={href} padded={false} class:list={['pa-industry-card', className]}>
  <div class="pa-industry-card__media">
    {imageSrc ? (
      <img src={imageSrc} alt={imageAlt} class="pa-media--cover" loading="lazy" />
    ) : (
      <div
        class:list={['pa-industry-card__placeholder', pattern && `pa-industry-card__placeholder--${pattern}`]}
        aria-hidden="true"
      >
        {index && <span class="pa-industry-card__index">{index}</span>}
      </div>
    )}
    <div class="pa-industry-card__overlay">
      <h3 class="pa-h3 pa-text-inverse">{title}</h3>
      {description && <p class="pa-caption pa-industry-card__desc">{description}</p>}
    </div>
  </div>
  <slot />
</Card>

<style>
  .pa-industry-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--pa-color-primary);
    overflow: hidden;
  }

  .pa-industry-card__media img,
  .pa-industry-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pa-industry-card__placeholder {
    background: linear-gradient(135deg, var(--pa-color-primary), var(--pa-color-primary-soft));
    position: relative;
  }

  .pa-industry-card__index {
    position: absolute;
    top: var(--pa-space-4);
    right: var(--pa-space-5);
    font-family: var(--pa-font-display);
    font-weight: var(--pa-weight-black);
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    line-height: 1;
    color: rgba(255, 255, 255, 0.12);
    letter-spacing: var(--pa-tracking-display);
  }

  .pa-industry-card__placeholder--btp {
    background:
      repeating-linear-gradient(
        135deg,
        var(--pa-color-primary) 0 14px,
        var(--pa-color-primary-mid) 14px 15px
      );
  }

  .pa-industry-card__placeholder--mines {
    background-color: var(--pa-color-primary);
    background-image:
      repeating-linear-gradient(
        0deg,
        transparent 0 18px,
        rgba(255, 255, 255, 0.04) 18px 19px
      ),
      repeating-linear-gradient(
        90deg,
        transparent 0 18px,
        rgba(255, 255, 255, 0.04) 18px 19px
      );
  }

  .pa-industry-card__placeholder--transport {
    background:
      repeating-linear-gradient(
        90deg,
        var(--pa-color-primary) 0 28px,
        var(--pa-color-primary-mid) 28px 29px
      );
  }

  .pa-industry-card__placeholder--agriculture {
    background:
      repeating-linear-gradient(
        0deg,
        var(--pa-color-primary) 0 22px,
        var(--pa-color-primary-soft) 22px 23px
      );
  }

  .pa-industry-card__placeholder--energie {
    background:
      repeating-linear-gradient(
        -25deg,
        var(--pa-color-primary) 0 16px,
        var(--pa-color-primary-mid) 16px 17px
      );
  }

  .pa-industry-card__overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--pa-space-5);
    background: linear-gradient(transparent, rgba(9, 24, 58, 0.92));
    display: flex;
    flex-direction: column;
    gap: var(--pa-space-2);
  }

  .pa-industry-card__desc {
    color: var(--pa-color-text-on-dark-muted);
  }
</style>

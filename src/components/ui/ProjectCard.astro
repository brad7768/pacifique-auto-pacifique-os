---
import ProductCard from './ProductCard.astro';

interface Props {
  title: string;
  description?: string;
  href?: string;
  imageSrc?: string;
  imageAlt?: string;
  location?: string;
  class?: string;
}
const { title, description, href, imageSrc, imageAlt = '', location, class: className = '' } = Astro.props;
---

<ProductCard
  title={title}
  description={description}
  href={href}
  imageSrc={imageSrc}
  imageAlt={imageAlt}
  meta={location ?? 'Projet'}
  class:list={['pa-project-card', className]}
>
  <slot />
</ProductCard>

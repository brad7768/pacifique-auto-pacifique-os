---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../data/site';
---

<!--
  PHASE 1 — Foundations status page.
  This is NOT the marketing homepage (Phase 2).
  It only proves shell + tokens wire correctly.
-->
<BaseLayout
  title="Phase 1 — Fondations"
  description={`Fondations techniques ${site.name}. Homepage prévue en Phase 2.`}
  noindex={true}
>
  <Section tone="inverse" tight>
    <Container>
      <Badge variant="inverse">Phase 1 · Foundations</Badge>
      <h1 class="pa-display" style="margin-top: var(--pa-space-6); max-width: 18ch;">
        Design system <em>&</em> architecture
      </h1>
      <p class="pa-lead" style="margin-top: var(--pa-space-5);">{site.slogan}</p>
      <p class="pa-body" style="margin-top: var(--pa-space-5); max-width: 36rem;">
        Le shell global, les tokens et les composants de base sont en place.
        La homepage marketing n’est pas démarrée — validation Phase 1 requise avant Phase 2.
      </p>
      <div class="pa-cluster" style="margin-top: var(--pa-space-8);">
        <Button href="/design-system" variant="primary">Voir le design system</Button>
      </div>
      <p class="pa-caption" style="margin-top: var(--pa-space-4); color: var(--pa-color-text-muted);">
        Specs : <code>docs/pacifique-auto/MASTER_SPEC.md</code> · Legacy préservé dans <code>/legacy</code>
      </p>
    </Container>
  </Section>

  <Section tone="subtle">
    <Container>
      <SectionHeader
        label="Périmètre Phase 1"
        title="Livrables fondations"
        intro="Tokens, shell, composants génériques, cartographies routes/images, QA. Aucune page métier construite."
      />
      <ul class="pa-stack" role="list" style="list-style: disc; padding-left: 1.25rem; color: var(--pa-color-text-muted);">
        <li>Architecture Astro SSG documentée</li>
        <li>Design tokens CSS uniques</li>
        <li>Header + mega menu + mobile + footer</li>
        <li>Bibliothèque de composants de base</li>
        <li>ROUTE_MAP · IMAGE_MAP · PAGE_DEPENDENCY_MAP · QA_CHECKLIST</li>
      </ul>
    </Container>
  </Section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';
import Button from '../components/ui/Button.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import FeatureCard from '../components/ui/FeatureCard.astro';
import VehicleCard from '../components/ui/VehicleCard.astro';
import IndustryCard from '../components/ui/IndustryCard.astro';
import BrandCard from '../components/ui/BrandCard.astro';
import ArticleCard from '../components/ui/ArticleCard.astro';
import CTASection from '../components/ui/CTASection.astro';
import { site } from '../data/site';
import {
  homeHubs,
  homeSolutions,
  homeIndustries,
  homeBrands,
  homeProof,
  homeNetwork,
  homeResources,
} from '../data/home';
---

<BaseLayout
  title={site.name}
  description="Pacifique Auto — véhicules, pièces, maintenance, flotte et financement. Des solutions qui font avancer l'Afrique Centrale."
  flushChrome={true}
>
  <!-- S1 Hero — navy structurel, sans IMG-001 (réservé véhicules / SINOTRUK) -->
  <Hero
    eyebrow="Pacifique Auto · Solutions industrielles"
    description="Véhicules, pièces, maintenance, flotte et financement pour accompagner les opérations qui font avancer les territoires."
    minHeight={true}
    class="pa-home-hero"
  >
    <h1 slot="heading" class="pa-display">
      <span>DES SOLUTIONS QUI FONT</span>
      <span>AVANCER L’AFRIQUE</span>
      <em>CENTRALE.</em>
    </h1>
    <div slot="actions" class="pa-cluster pa-home-cta">
      <Button href="/devis" variant="primary">Demander un devis</Button>
      <Button href="/solutions" variant="inverse-outline">Découvrir nos solutions</Button>
    </div>
  </Hero>

  <!-- S2 — 7 univers -->
  <Section>
    <Container>
      <SectionHeader
        label="Navigation"
        title="Explorer nos univers"
        intro="Accès direct aux pôles du site public."
      />
      <div class="pa-grid pa-grid--auto">
        {
          homeHubs.map((hub) => (
            <FeatureCard class="pa-hub-card" title={hub.title} description={hub.description} href={hub.href}>
              <span slot="icon" class="pa-mark" aria-hidden="true" />
            </FeatureCard>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- S3 — Solutions -->
  <Section tone="subtle">
    <Container>
      <SectionHeader
        label="Capacités"
        title="Solutions"
        intro="Véhicules, pièces, maintenance, flotte et financement."
      />
      <div class="pa-grid pa-grid--3 pa-solutions-grid">
        {
          homeSolutions.map((item) =>
            'useVehicleCard' in item && item.useVehicleCard ? (
              <VehicleCard
                title={item.title}
                description={item.description}
                href={item.href}
                imageSrc={item.imageSrc}
                imageAlt={item.imageAlt}
                model="Véhicules"
                class="pa-solution-card"
              />
            ) : (
              <FeatureCard class="pa-solution-card" title={item.title} description={item.description} href={item.href}>
                <span slot="icon" class="pa-mark" aria-hidden="true" />
                {'secondary' in item && item.secondary ? (
                  <p class="pa-solution-secondary">
                    <a href={item.secondary.href}>{item.secondary.label}</a>
                  </p>
                ) : null}
              </FeatureCard>
            )
          )
        }
      </div>
      <div class="pa-cluster pa-home-section-cta">
        <Button href="/solutions" variant="secondary">Toutes les solutions</Button>
        <Button href="/devis" variant="primary">Demander un devis</Button>
      </div>
    </Container>
  </Section>

  <!-- S4 — Industries -->
  <Section>
    <Container>
      <SectionHeader label="Secteurs" title="Industries" intro="Des réponses adaptées aux contraintes de chaque secteur." />
      <div class="pa-grid pa-grid--5">
        {
          homeIndustries.map((item) => (
            <IndustryCard class="pa-industry-homecard" title={item.title} description={item.description} href={item.href} />
          ))
        }
      </div>
      <div class="pa-cluster pa-home-section-cta">
        <Button href="/industries" variant="outline">Voir les industries</Button>
        <Button href="/devis" variant="primary">Demander un devis</Button>
      </div>
    </Container>
  </Section>

  <!-- S5 — Marques -->
  <Section tone="subtle">
    <Container>
      <SectionHeader label="Catalogue" title="Marques" intro="Constructeurs et références au catalogue." />
      <div class="pa-grid pa-grid--4">
        {homeBrands.map((brand) => <BrandCard class="pa-brand-homecard" name={brand.name} href={brand.href} />)}
      </div>
      <div class="pa-cluster pa-home-section-cta">
        <Button href="/marques" variant="outline">Toutes les marques</Button>
      </div>
    </Container>
  </Section>

  <!-- S6 — Pourquoi Pacifique Auto -->
  <Section tone="primary-mid">
    <Container>
      <SectionHeader
        label="Confiance"
        title="Pourquoi Pacifique Auto"
        intro="Une infrastructure industrielle et commerciale B2B."
        inverse
      />
      <div class="pa-grid pa-grid--2 pa-proof">
        {
          homeProof.map((pillar, i) => (
            <article class="pa-proof__item">
              <span class="pa-proof__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="pa-h4 pa-text-inverse">{pillar.title}</h3>
                <p class="pa-body pa-proof__text">{pillar.text}</p>
              </div>
            </article>
          ))
        }
      </div>
      <div class="pa-cluster pa-home-section-cta">
        <Button href="/a-propos" variant="primary">À propos</Button>
        <Button href="/contact" variant="inverse-outline">Nous contacter</Button>
      </div>
    </Container>
  </Section>

  <!-- S7 — Projets (état structurel : aucun case study publiable dans le repo) -->
  <Section>
    <Container>
      <SectionHeader
        label="Preuve terrain"
        title="Projets"
        intro="Les réalisations et études de cas validées sont rassemblées dans l’espace Projets."
      />
      <div class="pa-projects-state">
        <p class="pa-body">
          Sélection de réalisations en cours de préparation.
        </p>
        <Button href="/projets" variant="secondary">Tous les projets</Button>
      </div>
    </Container>
  </Section>

  <!-- S8 — Réseau (pas de carte inventée) -->
  <Section tone="subtle">
    <Container>
      <SectionHeader label="Couverture" title="Réseau" intro="Implantations, pièces, logistique." />
      <div class="pa-grid pa-grid--3">
        {
          homeNetwork.map((item) => (
            <FeatureCard class="pa-network-card" title={item.title} description={item.description} href={item.href}>
              <span slot="icon" class="pa-mark" aria-hidden="true" />
            </FeatureCard>
          ))
        }
      </div>
      <div class="pa-cluster pa-home-section-cta">
        <Button href="/reseau" variant="outline">Voir le réseau</Button>
        <Button href="/contact" variant="secondary">Nous contacter</Button>
      </div>
    </Container>
  </Section>

  <!-- S9 — Ressources -->
  <Section>
    <Container>
      <SectionHeader label="Contenus" title="Ressources" intro="Actualités, documentation, guides." />
      <div class="pa-grid pa-grid--3">
        {
          homeResources.map((item) => (
            <ArticleCard class="pa-resource-card" title={item.title} excerpt={item.excerpt} href={item.href} category={item.title} />
          ))
        }
      </div>
      <div class="pa-cluster pa-home-section-cta">
        <Button href="/ressources" variant="outline">Centre de ressources</Button>
      </div>
    </Container>
  </Section>

  <!-- S10 — CTA final -->
  <CTASection
    title="Parlons de votre prochain projet"
    description="Devis, flotte, pièces ou maintenance — notre équipe vous répond."
    primaryLabel="Demander un devis"
    primaryHref="/devis"
    secondaryLabel="Nous contacter"
    secondaryHref="/contact"
  />
</BaseLayout>

<style is:global>
  .pa-home-hero .pa-display {
    max-width: none;
    font-size: clamp(3.5rem, 5.25vw, 4.6rem);
    line-height: 0.9;
    letter-spacing: var(--pa-tracking-display);
  }

  .pa-home-hero .pa-display span,
  .pa-home-hero .pa-display em {
    display: block;
    font-style: normal;
  }

  .pa-home-hero .pa-hero__content {
    max-width: 52rem;
  }

  .pa-home-hero .pa-hero__desc {
    max-width: 34rem;
    color: var(--pa-color-text-on-dark-muted);
  }

  .pa-home-hero .pa-hero__eyebrow {
    margin-bottom: var(--pa-space-7);
  }

  .pa-home-hero .pa-hero__actions {
    margin-top: var(--pa-space-9);
  }

  .pa-mark {
    display: block;
    width: var(--pa-space-7);
    height: var(--pa-border-width-accent);
    background: var(--pa-color-accent);
  }

  .pa-home-section-cta {
    margin-top: var(--pa-space-8);
  }

  .pa-hub-card,
  .pa-network-card,
  .pa-solution-card,
  .pa-brand-homecard,
  .pa-resource-card {
    border: var(--pa-border-width) solid var(--pa-color-border-subtle);
  }

  .pa-hub-card {
    min-height: 13.5rem;
    padding: var(--pa-space-8) var(--pa-space-7);
  }

  .pa-hub-card .pa-feature-card__icon {
    width: var(--pa-space-9);
    height: var(--pa-space-9);
    margin-bottom: var(--pa-space-6);
    background: var(--pa-color-bg-subtle);
  }

  .pa-hub-card .pa-h3 {
    font-size: 1.5rem;
  }

  .pa-hub-card .pa-body,
  .pa-network-card .pa-body {
    color: var(--pa-color-text-secondary);
  }

  .pa-solutions-grid .pa-card {
    height: 100%;
  }

  .pa-solution-card {
    min-height: 18.5rem;
  }

  .pa-solution-card .pa-product-card__body {
    min-height: 11.5rem;
  }

  .pa-industry-homecard {
    min-height: 14rem;
    border: var(--pa-border-width) solid var(--pa-color-primary-soft);
  }

  .pa-industry-homecard .pa-industry-card__media {
    min-height: 14rem;
    height: 100%;
  }

  .pa-industry-homecard .pa-industry-card__overlay {
    padding: var(--pa-space-5);
  }

  .pa-industry-homecard .pa-h3 {
    font-size: 1.25rem;
  }

  .pa-brand-homecard {
    min-height: 11rem;
    justify-content: center;
    padding: var(--pa-space-7);
  }

  .pa-brand-homecard .pa-brand-card__logo {
    width: 5rem;
    height: 5rem;
  }

  .pa-network-card {
    min-height: 14.5rem;
  }

  .pa-network-card .pa-feature-card__icon {
    margin-bottom: var(--pa-space-6);
  }

  .pa-resource-card {
    min-height: 13rem;
  }

  .pa-resource-card .pa-product-card__body {
    min-height: 13rem;
    justify-content: center;
  }

  .pa-solution-secondary {
    margin-top: var(--pa-space-5);
    font-size: var(--pa-text-caption);
  }

  .pa-solution-secondary a {
    color: var(--pa-color-accent);
    text-decoration: none;
    font-family: var(--pa-font-display);
    font-weight: var(--pa-weight-bold);
    letter-spacing: var(--pa-tracking-wider);
    text-transform: uppercase;
  }

  .pa-solution-secondary a:hover {
    text-decoration: underline;
  }

  .pa-proof__item {
    display: flex;
    gap: var(--pa-space-5);
    padding: var(--pa-space-6) 0;
    border-top: var(--pa-border-width) solid rgba(255, 255, 255, 0.08);
  }

  .pa-proof__index {
    font-family: var(--pa-font-display);
    font-weight: var(--pa-weight-black);
    font-size: var(--pa-text-h3);
    color: var(--pa-color-accent);
    line-height: 1;
    min-width: 2.5rem;
  }

  .pa-proof__text {
    margin-top: var(--pa-space-2);
    color: var(--pa-color-text-on-dark-muted);
  }

  .pa-projects-state {
    display: flex;
    flex-direction: column;
    gap: var(--pa-space-6);
    max-width: 42rem;
    padding: var(--pa-space-8) var(--pa-space-9);
    border-left: var(--pa-border-width-accent) solid var(--pa-color-accent);
    border-top: var(--pa-border-width) solid var(--pa-color-border-subtle);
    border-right: var(--pa-border-width) solid var(--pa-color-border-subtle);
    border-bottom: var(--pa-border-width) solid var(--pa-color-border-subtle);
    background: var(--pa-color-bg-subtle);
  }

  @media (max-width: 768px) {
    .pa-home-hero .pa-display {
      font-size: clamp(2.45rem, 12vw, 3.5rem);
      line-height: 0.94;
    }

    .pa-home-hero .pa-display span,
    .pa-home-hero .pa-display em {
      display: inline;
    }

    .pa-home-hero .pa-display span::after {
      content: ' ';
    }

    .pa-home-cta .pa-btn,
    .pa-home-section-cta .pa-btn {
      width: 100%;
    }

    .pa-proof {
      grid-template-columns: 1fr;
    }

    .pa-hub-card,
    .pa-network-card,
    .pa-solution-card,
    .pa-resource-card {
      min-height: 0;
    }

    .pa-industry-homecard,
    .pa-industry-homecard .pa-industry-card__media {
      min-height: 12rem;
    }

    .pa-projects-state {
      padding: var(--pa-space-7);
    }
  }
</style>
